# Lightweight Dockerfile - Faster build for testing
# Use this if main Dockerfile is too slow

FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip

# Install only essential packages (much faster)
RUN pip install --no-cache-dir \
    numpy \
    SimpleITK \
    nibabel \
    matplotlib

# Install minimal MONAI (without all dependencies)
RUN pip install --no-cache-dir monai-weekly

# Install LungMask
RUN pip install --no-cache-dir git+https://github.com/JoHof/lungmask

# Copy pipeline components
COPY components/ /app/components/

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH

# Default command
CMD ["python", "--version"]
